@page "{id:guid}"
@model Vladify.Frontend.Pages.PlaylistsModel
@{
    ViewData["Title"] = null;
}

<div class="container-fluid px-4 mt-5">
    @if (Model.PlaylistModel == null)
    {
        <div class="alert alert-soft-warning d-flex align-items-center rounded-4 shadow-sm" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-3 fs-4"></i>
            <div>Плейлист не найден.</div>
        </div>
        <a asp-page="/Index" class="btn btn-light rounded-pill mt-3">← Назад к медиатеке</a>
    }
    else
    {
        <div class="row align-items-center mb-4">
            <div class="col-auto">
                <div class="playlist-hero-cover grad-purple shadow-lg rounded-4 d-flex align-items-center justify-content-center">
                    <i class="bi bi-music-note-beamed text-white display-1 opacity-50"></i>
                </div>
            </div>
            <div class="col">
                <div id="playlistNameContainer" class="d-flex align-items-center">
                    <h1 class="display-4 fw-bold mb-1 mt-0">@Model.PlaylistModel.Name</h1>
                    <button type="button" class="btn btn-link text-muted ms-3 p-0 edit-icon-btn" onclick="toggleEditName()" title="Изменить название">
                        <i class="bi bi-pencil-square fs-2"></i>
                    </button>
                </div>

                <form id="editNameForm" method="post" asp-page-handler="UpdatePlaylist" asp-route-id="@Model.PlaylistModel.Id" class="d-none mt-2">
                    <div class="d-flex align-items-center gap-2">
                        <input asp-for="PlaylistUpdateRequestModel.Name"
                               class="form-control form-control-lg fw-bold border-0 shadow-sm rounded-3"
                               style="max-width: 400px; font-size: 2rem;"
                               value="@Model.PlaylistModel.Name" />
                        <button type="submit" class="btn btn-vladify-save rounded-circle shadow-sm">
                            <i class="bi bi-check-lg text-white"></i>
                        </button>
                        <button type="button" class="btn btn-light rounded-circle shadow-sm" onclick="toggleEditName()">
                            <i class="bi bi-x-lg"></i>
                        </button>
                    </div>
                </form>

                <div class="d-flex align-items-center text-muted">
                    <span class="fw-bold text-dark">@Model.PlaylistModel.AuthorName</span>
                    <span class="mx-2">•</span>
                    <span>@Model.PlaylistModel.Songs.Count треков</span>
                </div>

                <div class="mt-3">
                    <button type="button" class="btn btn-delete-playlist-main btn-sm rounded-pill px-3"
                            data-bs-toggle="modal" data-bs-target="#confirmDeleteModal">
                        <i class="bi bi-trash3 me-2"></i>Удалить плейлист
                    </button>
                </div>
            </div>
        </div>

        <div class="d-flex align-items-center mb-4 gap-4">
            <button class="btn-vladify-play paused shadow-lg" id="mainPlayBtn" onclick="PlayerApp.togglePlayAll()">
                <svg class="vladify-play-svg vladify-symbol-paused" viewBox="0 0 16 16" width="40" height="40">
                    <path fill="black" d="m11.596 8.697-6.363 3.692c-.54.313-1.233-.066-1.233-.697V4.308c0-.63.692-1.01 1.233-.696l6.363 3.692a.802.802 0 0 1 0 1.393z"/>
                </svg>
                <svg class="vladify-play-svg vladify-symbol-playing" viewBox="0 0 16 16" width="40" height="40">
                    <path fill="black" d="M5.5 3.5A1.5 1.5 0 0 1 7 5v6a1.5 1.5 0 0 1-3 0V5a1.5 1.5 0 0 1 1.5-1.5zm5 0A1.5 1.5 0 0 1 12 5v6a1.5 1.5 0 0 1-3 0V5a1.5 1.5 0 0 1 1.5-1.5z"/>
                </svg>
            </button>
        </div>

        <div class="card border-0 shadow-sm rounded-4 overflow-hidden bg-white mb-5">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0 custom-table">
                    <thead class="bg-light text-muted small text-uppercase fw-bold">
                        <tr>
                            <th class="ps-4 py-3" style="width: 50px;">#</th>
                            <th>Название</th>
                            <th>Альбом</th>
                            <th class="text-end"><i class="bi bi-clock"></i></th>
                            <th class="text-end pe-4" style="width: 50px;"></th>
                        </tr>
                    </thead>
                    <tbody>
                        @{ int i = 0; }
                        @foreach (var song in Model.PlaylistModel.Songs)
                        {
                            <tr class="song-row"
                                data-song-index="@i"
                                data-song-id="@song.Id"
                                data-song-title="@song.Title"
                                data-song-author="@(song.Author ?? "Пользователь удалён")"
                                data-song-album="@song.Album"
                                data-song-audio="@song.AudioUrl"
                                data-song-image="@song.ImageUrl"
                                data-song-duration="@song.Duration"
                                onclick="PlayerApp.onRowClick(@i)">
                                <td class="ps-4 text-muted song-row-number">
                                    <span class="row-num">@(i + 1)</span>
                                    <i class="bi bi-play-fill row-play-icon"></i>
                                    <i class="bi bi-pause-fill row-pause-icon"></i>
                                </td>
                                <td>
                                    <div class="d-flex align-items-center">
                                        @if (!string.IsNullOrEmpty(song.ImageUrl))
                                        {
                                            <img src="@song.ImageUrl"
                                                 alt="@song.Title"
                                                 class="song-cover-img me-3 rounded shadow-sm" />
                                        }
                                        else
                                        {
                                            <div class="song-icon-placeholder me-3 rounded shadow-sm d-flex align-items-center justify-content-center">
                                                <i class="bi bi-music-note text-accent"></i>
                                            </div>
                                        }
                                        <div>
                                            <div class="fw-bold song-title">@song.Title</div>
                                            <div class="text-muted small">@(song.Author ?? "Пользователь удалён")</div>
                                        </div>
                                    </div>
                                </td>
                                <td class="text-muted small">@song.Album</td>
                                <td class="text-end text-muted small mono">
                                    @FormatDuration(song.Duration)
                                </td>
                                <td class="text-end pe-4">
                                    <form method="post"
                                          asp-page-handler="RemoveSong"
                                          asp-route-songId="@song.Id"
                                          asp-route-id="@Model.PlaylistModel.Id">
                                        <button type="submit" class="btn-delete-song" title="Удалить" onclick="event.stopPropagation()">
                                            <i class="bi bi-trash3"></i>
                                        </button>
                                    </form>
                                </td>
                            </tr>
                            i++;
                        }
                    </tbody>
                </table>
            </div>
            @if (!Model.PlaylistModel.Songs.Any())
            {
                <div class="text-center py-5">
                    <p class="text-muted fs-5">В этом плейлисте пока нет песен.</p>
                </div>
            }
        </div>
    }

    <div class="modal fade" id="confirmDeleteModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered" style="max-width: 400px;">
            <div class="modal-content border-0 shadow-lg rounded-4">
                <div class="modal-body p-4 text-center">
                    <div class="mb-3">
                        <i class="bi bi-exclamation-circle display-3 opacity-75" style="color: #cca4a4;"></i>
                    </div>

                    <h4 class="fw-bold mb-2">Удалить плейлист?</h4>
                    <p class="text-muted mb-4">
                        Вы уверены, что хотите удалить плейлист
                        <strong>@Model.PlaylistModel!.Name</strong>
                    </p>

                    <div class="d-grid gap-2">
                        <form method="post" asp-page-handler="DeletePlaylist" asp-route-id="@Model.PlaylistModel.Id">
                            <button type="submit" class="btn btn-soft-confirm w-100 rounded-pill py-2 fw-bold">
                                Да, удалить плейлист
                            </button>
                        </form>
                        <button type="button" class="btn btn-light w-100 rounded-pill py-2 text-muted shadow-none" data-bs-dismiss="modal">
                            Отмена
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@functions {
    private string FormatDuration(TimeSpan duration)
    {
        if (duration.TotalHours >= 1)
            return duration.ToString(@"hh\:mm\:ss");
        return duration.ToString(@"mm\:ss");
    }
}

@section Scripts {
    <script>
        // Загружаем плейлист из строк таблицы на этой странице
        PlayerApp.loadPlaylistFromRows();

        // Также обновляем состояние UI плеера на основе текущего глобального состояния
        const currentSongId = PlayerApp.getCurrentSongId();
        if (currentSongId) {
            const currentSongIndexInPage = PlayerApp.playlist.findIndex(s => s.id === currentSongId);
            if (currentSongIndexInPage !== -1) {
                PlayerApp.updateAllUI(PlayerApp.isPlaying());
            } else {
                PlayerApp.updateAllUI(PlayerApp.isPlaying());
            }
        } else {
             PlayerApp.updateAllUI(PlayerApp.isPlaying());
        }

        // Логика переключения формы редактирования названия плейлиста
        function toggleEditName() {
            const container = document.getElementById('playlistNameContainer');
            const form = document.getElementById('editNameForm');

            if (form.classList.contains('d-none')) {
                container.classList.add('d-none');
                form.classList.remove('d-none');
                form.querySelector('input').focus();
            } else {
                container.classList.remove('d-none');
                form.classList.add('d-none');
            }
        }
    </script>
}

<style>
    /* Удаляем все стили плеера и кнопок play/pause,
       так как они теперь определены глобально в player.css */

    /* Оставляем только специфичные для этой страницы стили */
    .playlist-hero-cover {
        width: 170px;
        height: 170px;
    }

    .grad-purple { background: linear-gradient(135deg, #a777ef 0%, #8c5cdb 100%); }

    /* Стили для таблицы песен */
    .custom-table thead th { border-bottom: none; font-size: 0.7rem; color: #adb5bd; }
    /* Song-row styles (active, playing, paused) должны браться из player.css */
    .song-row { cursor: pointer; transition: background-color 0.2s; }
    .song-row:hover { background-color: rgba(116, 185, 255, 0.05) !important; }
    .song-row:hover .song-title { color: var(--accent-color); }

    /* Обложка песни в таблице */
    .song-cover-img {
        width: 38px;
        height: 38px;
        object-fit: cover;
        border: 1px solid rgba(0,0,0,0.05);
        flex-shrink: 0;
    }

    .song-icon-placeholder {
        width: 38px;
        height: 38px;
        background-color: #f8f9fa;
        border: 1px solid rgba(0,0,0,0.02);
    }

    .text-accent { color: var(--accent-color); }
    .mono { font-family: 'SFMono-Regular', Consolas, monospace; letter-spacing: -0.5px; }

    /* Стили для alert-ов */
    .alert-soft-warning {
        background-color: #fff9db;
        border: 1px solid #ffec99;
        color: #f08c00;
    }

    /* Стили для кнопок редактирования и удаления */
    .btn-delete-song {
        background: none;
        border: none;
        color: #adb5bd;
        transition: all 0.2s ease;
        padding: 5px;
        border-radius: 8px;
        position: relative;
        z-index: 2; /* чтобы был над onclick строки */
    }
    .btn-delete-song:hover {
        color: #ff4757;
        background-color: rgba(255, 71, 87, 0.1);
        transform: scale(1.1);
    }

    .edit-icon-btn {
        transition: all 0.2s ease;
        opacity: 0.6;
    }
    .edit-icon-btn:hover {
        opacity: 1;
        color: var(--vladify-green, #27b89d) !important; /* Используем новую переменную */
        transform: scale(1.1);
    }

    .btn-vladify-save {
        background: linear-gradient(135deg, #41d3b7 0%, #27b89d 100%);
        border: none;
        width: 45px;
        height: 45px;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: 0.2s;
        border-radius: 50px; /* Круглая кнопка для сохранения */
    }
    .btn-vladify-save:hover {
        filter: brightness(1.1);
        transform: scale(1.05);
    }

    .btn-delete-playlist-main {
        background-color: rgba(255, 71, 87, 0.05);
        color: #ff4757;
        border: 1px solid rgba(255, 71, 87, 0.2);
        font-weight: 500;
        transition: all 0.2s ease;
    }

    .btn-delete-playlist-main:hover {
        background-color: #ff4757;
        color: white;
        border-color: #ff4757;
        transform: translateY(-1px);
        box-shadow: 0 4px 12px rgba(255, 71, 87, 0.3);
    }

    .btn-delete-playlist-main:active {
        transform: translateY(0);
    }

    .btn-soft-confirm {
        background-color: #ee5253;
        color: #ffffff;
        border: none;
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        box-shadow: 0 4px 12px rgba(238, 82, 83, 0.3);
    }

    .btn-soft-confirm:hover {
        background-color: #d43d3d;
        color: #ffffff;
        box-shadow: 0 6px 18px rgba(255, 87, 88, 0.45);
        transform: translateY(-1px);
    }

    .btn-soft-confirm:active {
        transform: scale(0.98);
    }
</style>