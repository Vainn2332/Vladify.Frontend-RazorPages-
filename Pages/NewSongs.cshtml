@page
@model Vladify.Frontend.Pages.NewSongsModel
@{
    ViewData["Title"] = "Новые песни";
}

<div class="container-fluid px-4 mt-5">
    @if (Model.Songs == null || !Model.Songs.Any())
    {
        <div class="row align-items-end mb-4">
            <div class="col-auto">
                <div class="playlist-hero-cover grad-orange shadow-lg rounded-4 d-flex align-items-center justify-content-center">
                    <i class="bi bi-stars text-white display-1 opacity-60"></i>
                </div>
            </div>
            <div class="col pb-1">
                <h1 class="display-4 fw-bold mb-1 mt-0">Новые песни</h1>
                <div class="text-muted">
                    <span>Свежие треки нашей библиотеки</span>
                </div>
            </div>
        </div>

        <div class="card border-0 shadow-sm rounded-4 overflow-hidden bg-white mb-5">
            <div class="text-center py-5">
                <i class="bi bi-music-note-beamed display-1 text-muted opacity-25 mb-3 d-block"></i>
                <p class="text-muted fs-5 fw-medium">Пока нет новых песен.</p>
            </div>
        </div>
    }
    else
    {
        <div class="row align-items-end mb-4">
            <div class="col-auto">
                <div class="playlist-hero-cover grad-orange shadow-lg rounded-4 d-flex align-items-center justify-content-center">
                    <i class="bi bi-stars text-white display-1 opacity-60"></i>
                </div>
            </div>
            <div class="col pb-1">
                <div class="d-flex align-items-center">
                    <h1 class="display-4 fw-bold mb-1 mt-0">Новые песни</h1>
                </div>
                <div class="d-flex align-items-center text-muted">
                    <span class="fw-bold text-dark">Свежие треки</span>
                    <span class="mx-2">•</span>
                    <span>@Model.Songs.Count треков</span>
                </div>
            </div>
        </div>

        <div class="d-flex align-items-center mb-4">
            <button class="btn-vladify-play paused shadow-lg" id="mainPlayBtn" onclick="PlayerApp.togglePlayAll()" type="button">
                <svg class="vladify-play-svg vladify-symbol-paused" viewBox="0 0 16 16" width="40" height="40">
                    <path fill="black" d="m11.596 8.697-6.363 3.692c-.54.313-1.233-.066-1.233-.697V4.308c0-.63.692-1.01 1.233-.696l6.363 3.692a.802.802 0 0 1 0 1.393z" />
                </svg>
                <svg class="vladify-play-svg vladify-symbol-playing" viewBox="0 0 16 16" width="40" height="40">
                    <path fill="black" d="M5.5 3.5A1.5 1.5 0 0 1 7 5v6a1.5 1.5 0 0 1-3 0V5a1.5 1.5 0 0 1 1.5-1.5zm5 0A1.5 1.5 0 0 1 12 5v6a1.5 1.5 0 0 1-3 0V5a1.5 1.5 0 0 1 1.5-1.5z" />
                </svg>
            </button>
        </div>

        <div class="card border-0 shadow-sm rounded-4 overflow-hidden bg-white mb-5">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0 custom-table">
                    <thead class="bg-light text-muted small text-uppercase fw-bold">
                        <tr>
                            <th class="ps-4 py-3" style="width: 60px;">#</th>
                            <th>Название</th>
                            <th>Альбом</th>
                            <th>Дата добавления</th>
                            <th class="text-end pe-4" style="width: 100px;"><i class="bi bi-clock"></i></th>
                        </tr>
                    </thead>
                    <tbody>
                        @{
                            int i = 0;
                        }
                        @foreach (var song in Model.Songs)
                        {
                            <tr class="song-row"
                                data-song-index="@i"
                                data-song-id="@song.Id"
                                data-song-title="@song.Title"
                                data-song-author="@song.Author"
                                data-song-album="@song.Album"
                                data-song-audio="@song.AudioUrl"
                                data-song-image="@song.ImageUrl"
                                data-song-duration="@song.Duration"
                                onclick="PlayerApp.onRowClick(@i)">

                                <td class="ps-4 text-muted">
                                    <div class="song-row-number">
                                        <span class="row-num">@(i + 1)</span>
                                        <i class="bi bi-play-fill row-play-icon"></i>
                                        <i class="bi bi-pause-fill row-pause-icon"></i>
                                    </div>
                                </td>

                                <td>
                                    <div class="d-flex align-items-center py-1">
                                        @if (!string.IsNullOrEmpty(song.ImageUrl))
                                        {
                                            <img src="@song.ImageUrl"
                                                 alt="@song.Title"
                                                 class="song-cover-img me-3" />
                                        }
                                        else
                                        {
                                            <div class="song-icon-placeholder me-3">
                                                <i class="bi bi-music-note text-accent"></i>
                                            </div>
                                        }
                                        <div>
                                            <div class="fw-bold song-title fs-6">@song.Title</div>
                                            <div class="text-muted small">@song.Author</div>  <!-- ← АВТОР ЗДЕСЬ -->
                                        </div>
                                    </div>
                                </td>

                                <td class="text-muted small">@song.Album</td>

                                <td class="text-muted small">
                                    <div class="d-flex align-items-center gap-2">
                                        <i class="bi bi-calendar3 text-accent"></i>
                                        <span>@FormatDate(song.CreatedAt)</span>
                                    </div>
                                </td>

                                <td class="text-end pe-4 text-muted small mono">
                                    @FormatDuration(song.Duration)
                                </td>
                            </tr>
                            i++;
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>

@functions {
    private string FormatDuration(TimeSpan duration)
    {
        if (duration.TotalHours >= 1)
            return duration.ToString(@"hh\:mm\:ss");
        return duration.ToString(@"mm\:ss");
    }

    private string FormatDate(DateTime date)
    {
        var now = DateTime.UtcNow;
        var diff = now - date;

        if (diff.TotalMinutes < 1) return "только что";
        if (diff.TotalMinutes < 60) return $"{(int)diff.TotalMinutes} мин назад";
        if (diff.TotalHours < 24) return $"{(int)diff.TotalHours} ч назад";
        if (diff.TotalDays < 7) return $"{(int)diff.TotalDays} дн назад";
        if (diff.TotalDays < 30) return $"{(int)(diff.TotalDays / 7)} нед назад";

        return date.ToString("dd MMM yyyy", new System.Globalization.CultureInfo("ru-RU"));
    }
}

@section Scripts {
    <script>
        // Загружаем плейлист в глобальный плеер
        PlayerApp.loadPlaylistFromRows();

        // Обновляем UI плеера
        PlayerApp.updateAllUI(PlayerApp.isPlaying());
    </script>
}

<style>
    :root {
        --accent-color: #74b9ff;
        --vladify-btn-grad: linear-gradient(135deg, #41d3b7 0%, #27b89d 100%);
        --vladify-btn-hover: linear-gradient(135deg, #51e3c7 0%, #2cccae 100%);
    }

    .playlist-hero-cover {
        width: 170px;
        height: 170px;
    }

        .playlist-hero-cover.grad-orange {
            background: linear-gradient(135deg, #ff9966 0%, #ff5e62 100%);
        }

    .btn-vladify-play {
        width: 64px;
        height: 64px;
        border-radius: 50%;
        background: var(--vladify-btn-grad);
        border: none;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: all 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275);
        position: relative;
    }

    .vladify-play-svg {
        display: none;
        width: 40px;
        height: 40px;
    }

    .btn-vladify-play.paused .vladify-symbol-paused {
        display: block;
        margin-left: 5px;
    }

    .btn-vladify-play.playing .vladify-symbol-playing {
        display: block;
    }

    .btn-vladify-play:hover {
        transform: scale(1.1);
        background: var(--vladify-btn-hover);
        box-shadow: 0 8px 20px rgba(39, 184, 157, 0.4) !important;
    }

    .btn-vladify-play:active {
        transform: scale(0.95);
    }

    .alert-soft-warning {
        background-color: #fff9db;
        border: 1px solid #ffec99;
        color: #f08c00;
    }

    /* ===== TABLE ===== */
    .custom-table thead th {
        border-bottom: none;
        font-size: 0.7rem;
        color: #adb5bd;
    }

    .song-row {
        cursor: pointer;
        transition: background-color 0.2s;
    }

        .song-row:hover {
            background-color: rgba(116, 185, 255, 0.05) !important;
        }

            .song-row:hover .song-title {
                color: var(--accent-color);
            }

    /* ===== ОБЛОЖКА ПЕСНИ ===== */
    .song-cover-img {
        width: 56px !important;
        height: 56px !important;
        object-fit: cover;
        border-radius: 6px;
        border: 1px solid rgba(0, 0, 0, 0.08);
        box-shadow: 0 2px 6px rgba(0, 0, 0, 0.08);
        flex-shrink: 0;
    }

    .song-icon-placeholder {
        width: 56px;
        height: 56px;
        background-color: #f8f9fa;
        border: 1px solid rgba(0, 0, 0, 0.05);
        border-radius: 6px;
        flex-shrink: 0;
        display: flex;
        align-items: center;
        justify-content: center;
    }

        .song-icon-placeholder .bi {
            font-size: 1.5rem;
        }

    .text-accent {
        color: var(--accent-color);
    }

    .mono {
        font-family: 'SFMono-Regular', Consolas, monospace;
        letter-spacing: -0.5px;
    }

    /* ===== ИКОНКИ В НОМЕРЕ СТРОКИ ===== */
    .song-row-number {
        position: relative;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-width: 24px;
    }

    .row-play-icon,
    .row-pause-icon {
        display: none;
        font-size: 1rem;
    }

    .row-num {
        display: inline;
    }

    .song-row:hover .row-num {
        display: none;
    }

    .song-row:hover .row-play-icon {
        display: inline;
        color: var(--accent-color);
    }

    .song-row.playing-song .row-num {
        display: none;
    }

    .song-row.playing-song .row-play-icon {
        display: none !important;
    }

    .song-row.playing-song .row-pause-icon {
        display: inline;
        color: #41d3b7;
    }

    .song-row.paused-song .row-num {
        display: none;
    }

    .song-row.paused-song .row-pause-icon {
        display: none !important;
    }

    .song-row.paused-song .row-play-icon {
        display: inline;
        color: #41d3b7;
    }

    .song-row.active-song {
        background-color: rgba(65, 211, 183, 0.06) !important;
    }

        .song-row.active-song .song-title {
            color: #41d3b7 !important;
        }
</style>