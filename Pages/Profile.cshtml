@page
@using Vladify.Frontend.models
@model Vladify.Frontend.Pages.ProfileModel
@{
    ViewData["Title"] = "Мой Профиль";
}

<style>
    .profile-avatar {
        width: 240px;
        height: 240px;
        object-fit: cover;
        transition: transform 0.3s ease;
    }
    
        .profile-avatar:hover {
            transform: scale(1.02);
        }

    .form-control, .form-select {
        transition: all 0.2s ease-in-out;
        border: 1px solid transparent !important;
    }

        .form-control:focus, .form-select:focus {
            background-color: #fff !important;
            border-color: #74b9ff !important;
            box-shadow: 0 0 0 0.25rem rgba(116, 185, 255, 0.25) !important;
            transform: translateY(-1px);
        }

    .btn-save {
        transition: all 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275);
    }

        .btn-save:hover {
            transform: translateY(-2px) scale(1.05);
            filter: brightness(1.1);
        }

        .btn-save:active {
            transform: translateY(0) scale(0.98);
        }
</style>

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-4 text-center mb-4">
            <div class="position-relative d-inline-block">
                @{
                    var userPic = User?.FindFirst("picture")?.Value
                                 ?? $"https://ui-avatars.com/api/?name={Model.UserModel.Name}&size=300&background=74b9ff&color=fff";
                }
                <img src="@userPic"
                     class="profile-avatar rounded-circle shadow-lg border border-4 border-white"
                     alt="User Avatar"
                     onerror="this.onerror=null; this.src='/images/defaultUser.png';" />
            </div>
            <h4 class="mt-3 fw-bold">@Model.UserModel.Name</h4>
            <p class="text-muted">@Model.UserModel.EmailAddress</p>
        </div>

        <div class="col-md-7">
            <div class="card p-4 border-0 shadow-sm rounded-4">
                <h5 class="mb-4 fw-bold text-primary">Настройки профиля</h5>
                
                <form method="post">
                    <input type="hidden" asp-for="UserModel.Id" />  
                    <input type="hidden" asp-for="UserModel.ExternalId" />
                    <input type="hidden" asp-for="UserModel.EmailAddress" />

                    <div class="row g-3">
                        <div class="col-12">
                            <label asp-for="UserModel.Name" class="form-label small fw-bold text-muted text-uppercase">Имя пользователя</label>
                            <input asp-for="UserModel.Name" class="form-control form-control-lg bg-light" placeholder="Введите имя..." />
                            <span asp-validation-for="UserModel.Name" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="UserModel.Age" class="form-label small fw-bold text-muted text-uppercase">Возраст</label>
                            <input asp-for="UserModel.Age" class="form-control form-control-lg bg-light" type="number" min="1" max="120" />
                            <span asp-validation-for="UserModel.Age" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="UserModel.Gender" class="form-label small fw-bold text-muted text-uppercase">Пол</label>
                            <select asp-for="UserModel.Gender"
                                    asp-items="Html.GetEnumSelectList<Gender>()"
                                    class="form-select form-control-lg bg-light">
                            </select>
                        </div>
                    </div>

                    <hr class="my-4 opacity-25" />

                    <div class="d-grid gap-2 d-md-flex justify-content-md-end">
                        <button type="submit" class="btn btn-primary btn-save btn-lg px-5 rounded-pill shadow-sm" style="background-color: #74b9ff; border: none;">
                            Сохранить изменения
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        $(document).ready(function () {
            $('form').bind('invalid-form.validate', function () {
                if (typeof showToast === "function") {
                    showToast("Проверьте правильность заполнения полей", "error");
                } else {
                    console.log("Ошибки в форме, но функция showToast не найдена");
                }
            });
        });
    </script>
}