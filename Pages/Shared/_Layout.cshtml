<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] Vladify</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Vladify.Frontend.styles.css" asp-append-version="true" />
    
    <style>
            /* Мягкий фон: от "Морской пены" в белый */
            body {
                background: linear-gradient(180deg, #C4DFE6 0%, #ffffff 100%);
                min-height: 100vh;
                background-attachment: fixed;
            }

            /* Хедер: переход от "Волны" к "Морской пене" */
            .vladify-header {
                background: linear-gradient(90deg, #66A5AD 0%, #85B9C0 100%) !important;
            }

            
                /* Чтобы текст на темной части хедера читался лучше */
                .vladify-header .navbar-brand {
                    color: white !important;
                    font-weight: 500;
                }
    </style>
</head>
<body>
    <header>
        @* Убрал bg-white, добавил класс vladify-header *@
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light border-bottom box-shadow mb-3 vladify-header">
            <div class="container">
                <a class="navbar-brand" asp-area="" asp-page="/Index">Vladify</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                    </ul>

                    <ul class="navbar-nav">
                        @{
                            var userPic = User.FindFirst("picture")?.Value;
                        }
                    
                        @if (!string.IsNullOrEmpty(userPic))
                        {
                            <li class="nav-item">
                                <a asp-page="/Profile" class="d-flex align-items-center">
                                    <img src="@userPic"
                                         alt="Profile"
                                         title="@User.Identity?.Name"
                                         class="rounded-circle border"
                                         style="width: 45px; height: 45px; object-fit: cover;" />
                                </a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <div id="toast-container"></div>

    <script>
            function showToast(message, type = 'success') {
                const container = document.getElementById('toast-container');
                const toast = document.createElement('div');
        
                toast.className = `vladify-toast ${type === 'success' ? 'toast-success' : 'toast-error'}`;
                toast.innerHTML = `<span>${message}</span>`;

                container.appendChild(toast);

                setTimeout(() => {
                    toast.classList.add('toast-fade-out');
                    setTimeout(() => toast.remove(), 300);
                }, 4000);

                toast.onclick = () => toast.remove();
            }

            document.addEventListener('DOMContentLoaded', () => {
                const successMsg = '@TempData["SuccessMessage"]';
                const errorMsg = '@TempData["ErrorMessage"]';

                if (successMsg) showToast(successMsg, 'success');
                if (errorMsg) showToast(errorMsg, 'error');
            });
    </script>
    @await RenderSectionAsync("Scripts", required: false)</body>
</html>