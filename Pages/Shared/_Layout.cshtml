<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] Vladify</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Vladify.Frontend.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="~/css/player.css" asp-append-version="true" /> <!-- Подключаем CSS плеера -->

    <style>
            body {
                background: linear-gradient(180deg, #C4DFE6 0%, #ffffff 100%);
                min-height: 100vh;
                background-attachment: fixed;
            }
            /* Hover на песне в поиске */
            .search-song-item {
                transition: background-color 0.15s ease;
            }

                .search-song-item:hover {
                    background-color: rgba(116, 185, 255, 0.1) !important;
                }

                    .search-song-item:hover .text-dark {
                        color: var(--accent-color, #74b9ff) !important;
                    }

    </style>
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light border-bottom box-shadow mb-3 vladify-header">
            <div class="container">
                <div class="d-flex align-items-center">
                    <a class="navbar-brand" asp-area="" asp-page="/Index">Vladify</a>
                    <a class="navbar-brand ms-3" asp-area="" asp-page="/MySongs">Мои песни</a>
                </div>
                <div class="position-relative mx-auto" style="width: 40%;" id="live-search-container">
                    <div class="input-group">
                        <span class="input-group-text bg-white border-end-0 rounded-start-pill text-muted">
                            <i class="bi bi-search"></i>
                        </span>
                        <input type="text"
                               id="live-search-input"
                               class="form-control border-start-0 rounded-end-pill shadow-none"
                               placeholder="Поиск треков и исполнителей..."
                               autocomplete="off">
                    </div>
                    <div id="live-search-dropdown"
                         class="dropdown-menu w-100 shadow-lg border-0 rounded-4 mt-2 p-2 d-none"
                         style="position: absolute; top: 100%; left: 0; z-index: 1050; max-height: 400px; overflow-y: auto;">
                    </div>
                </div>
                <div class="d-flex align-items-center">
                    @{
                        var userPic = User.FindFirst("picture")?.Value;
                    }
                    @if (!string.IsNullOrEmpty(userPic))
                    {
                        <div class="me-3">
                            <a asp-page="/Profile" class="d-flex align-items-center text-decoration-none">
                                <img src="@userPic"
                                     alt="Profile"
                                     title="@User.Identity?.Name"
                                     class="rounded-circle border"
                                     style="width: 40px; height: 40px; object-fit: cover;"
                                     onerror="this.onerror=null; this.src='/images/defaultUser.png'" />
                            </a>
                        </div>
                    }
                    <form asp-page="Account/Logout" method="post" class="d-inline">
                        <button type="submit"
                                class="btn btn-light text-danger shadow-sm d-flex align-items-center gap-2"
                                style="border-radius: 50px; padding: 6px 16px; font-weight: 600;">
                            <i class="bi bi-box-arrow-right" style="font-size: 1.1rem;"></i>
                            <span>Выйти</span>
                        </button>
                    </form>
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-player">
            @RenderBody()
        </main>
    </div>
    <div class="player-bar" id="playerBar">
        <div class="player-inner">
            <div class="player-left">
                <img src="" alt="" class="player-cover" id="playerCover" />
                <div class="player-song-info">
                    <div class="player-song-title" id="playerTitle">—</div>
                    <div class="player-song-author" id="playerAuthor">—</div>
                </div>
            </div>

            <div class="player-center">
                <div class="player-controls">
                    <button class="player-ctrl-btn" onclick="PlayerApp.playPrev()" title="Предыдущая">
                        <i class="bi bi-skip-start-fill"></i>
                    </button>
                    <button class="player-ctrl-btn play-pause-btn" onclick="PlayerApp.togglePlayPause()" title="Воспроизвести">
                        <i class="bi bi-play-fill" id="iconPlay"></i>
                        <i class="bi bi-pause-fill d-none" id="iconPause"></i>
                    </button>
                    <button class="player-ctrl-btn" onclick="PlayerApp.playNext()" title="Следующая">
                        <i class="bi bi-skip-end-fill"></i>
                    </button>
                </div>
                <div class="player-progress-row">
                    <span class="player-time" id="playerCurrentTime">0:00</span>
                    <div class="player-progress-bar" id="progressBarContainer">
                        <div class="player-progress-bg">
                            <div class="player-progress-fill" id="progressFill"></div>
                        </div>
                        <div class="player-progress-thumb" id="progressThumb"></div>
                    </div>
                    <span class="player-time" id="playerDuration">0:00</span>
                </div>
            </div>

            <div class="player-right">
                <button class="player-ctrl-btn" onclick="PlayerApp.toggleMute()" title="Громкость">
                    <i class="bi bi-volume-up-fill" id="iconVolumeUp"></i>
                    <i class="bi bi-volume-mute-fill d-none" id="iconVolumeMute"></i>
                </button>
                <div class="player-volume-bar" id="volumeBarContainer">
                    <div class="player-volume-bg">
                        <div class="player-volume-fill" id="volumeFill" style="width:100%"></div>
                    </div>
                    <div class="player-volume-thumb" id="volumeThumb" style="left:100%"></div>
                </div>
            </div>
        </div>
        <audio id="audioPlayer" preload="metadata"></audio>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/player.js" asp-append-version="true"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <div id="toast-container"></div>
    <script>
            // ==================== TOAST ====================
            function showToast(message, type = 'success') {
                const container = document.getElementById('toast-container');
                if (!container) return;
                const toast = document.createElement('div');
                toast.className = `vladify-toast ${type === 'success' ? 'toast-success' : 'toast-error'}`;
                toast.innerHTML = `<span>${message}</span>`;
                container.appendChild(toast);
                setTimeout(() => {
                    toast.classList.add('toast-fade-out');
                    setTimeout(() => toast.remove(), 300);
                }, 5000);
                toast.onclick = () => toast.remove();
            }

            document.addEventListener('DOMContentLoaded', () => {
                const successMsg = '@TempData["SuccessMessage"]';
                const errorMsg = '@TempData["ErrorMessage"]';
                if (successMsg) showToast(successMsg, 'success');
                if (errorMsg) showToast(errorMsg, 'error');
            });

            // ==================== SEARCH & CACHE ====================
            window.searchResultsCache = [];

            document.addEventListener('DOMContentLoaded', () => {
                let debounceTimer;
                const searchInput = document.getElementById('live-search-input');
                const searchDropdown = document.getElementById('live-search-dropdown');
                const searchContainer = document.getElementById('live-search-container');
                const csrfToken = document.querySelector('input[name="__RequestVerificationToken"]')?.value || '';
                const currentUrl = window.location.pathname + window.location.search;
                if (!searchInput) return;

                searchInput.addEventListener('input', function () {
                    clearTimeout(debounceTimer);
                    const query = this.value.trim();

                    if (query.length < 2) {
                        hideDropdown();
                        return;
                    }
                    debounceTimer = setTimeout(() => {
                        fetch(`/Search?handler=Results&q=${encodeURIComponent(query)}`)
                            .then(response => response.json())
                            .then(data => renderSearchResults(data))
                            .catch(err => console.error("Ошибка поиска:", err));
                    }, 300);
                });

                function renderSearchResults(data) {
                    searchDropdown.innerHTML = '';
                    const hasUsers = data.users && data.users.length > 0;
                    const hasSongs = data.songs && data.songs.length > 0;

                    if (!hasUsers && !hasSongs) {
                        searchDropdown.innerHTML = '<div class="p-3 text-center text-muted small">Ничего не найдено</div>';
                        showDropdown();
                        return;
                    }

                    // КЕШИРУЕМ ПЕСНИ (приводим к единому формату)
                    window.searchResultsCache = (data.songs || []).map(s => ({
                        id: s.id || s.Id,
                        title: s.title || s.Title || 'Неизвестно',
                        author: s.author || s.Author || 'Неизвестно',
                        album: s.album || s.Album || '',
                        audioUrl: s.audioUrl || s.AudioUrl,
                        imageUrl: s.imageUrl || s.ImageUrl || '',
                        duration: s.duration || s.Duration || ''
                    }));

                    let html = '';

                    // ============ ИСПОЛНИТЕЛИ ============
                    if (hasUsers) {
                        html += '<div class="dropdown-header fw-bold text-muted text-uppercase small pt-1 px-2">Исполнители</div>';
                        data.users.forEach(user => {
                            html += `
                                <a href="/Songs/${user.id || user.Id}" class="dropdown-item d-flex align-items-center gap-3 py-2 rounded-3 text-decoration-none">
                                    <i class="bi bi-person-circle fs-4 text-muted"></i>
                                    <div>
                                        <div class="fw-medium text-dark">${escapeHtml(user.name || user.Name)}</div>
                                        <div class="text-muted small" style="font-size: 0.7rem;">${escapeHtml(user.emailAddress || user.EmailAddress)}</div>
                                    </div>
                                </a>
                            `;
                        });
                    }

                    // ============ ТРЕКИ ============
                    if (hasSongs) {
                        if (hasUsers) html += '<hr class="my-2 opacity-10">';
                        html += '<div class="dropdown-header fw-bold text-muted text-uppercase small pt-1 px-2">Треки</div>';

                        let playlistsHtml = '';
                        if (data.playlists && data.playlists.length > 0) {
                            data.playlists.forEach(pl => {
                                playlistsHtml += `
                                    <div class="p-1">
                                        <form method="post" action="/Search?handler=AddToPlaylist" class="m-0">
                                            <input type="hidden" name="__RequestVerificationToken" value="${csrfToken}" />
                                            <input type="hidden" name="songId" value="SONG_ID_PLACEHOLDER" />
                                            <input type="hidden" name="playlistId" value="${pl.id || pl.Id}" />
                                            <input type="hidden" name="returnUrl" value="${currentUrl}" />
                                            <button type="submit" class="btn btn-sm btn-light w-100 text-start text-truncate small py-1" style="max-width: 180px; background: transparent;">
                                                ${escapeHtml(pl.name || pl.Name)}
                                            </button>
                                        </form>
                                    </div>
                                `;
                            });
                        } else {
                            playlistsHtml = '<div class="p-2 text-muted small text-center">Нет плейлистов</div>';
                        }

                        // Рендерим треки, передаем событие event в onclick
                        window.searchResultsCache.forEach((song, idx) => {
                            const currentSongPlaylistsHtml = playlistsHtml.replace(/SONG_ID_PLACEHOLDER/g, song.id);

                            const cover = song.imageUrl
                                ? `<img src="${escapeHtml(song.imageUrl)}" alt="" class="rounded shadow-sm flex-shrink-0" style="width: 38px; height: 38px; object-fit: cover;" />`
                                : `<div class="bg-light rounded p-1 d-flex align-items-center justify-content-center flex-shrink-0 shadow-sm" style="width: 38px; height: 38px;">
                                      <i class="bi bi-music-note text-accent"></i>
                                   </div>`;

                            html += `
                                <div class="dropdown-item d-flex align-items-center justify-content-between py-2 rounded-3 search-song-item"
                                     style="cursor: pointer; overflow: visible;"
                                     onclick="window.playSearchSong(${idx}, event)">

                                    <div class="d-flex align-items-center gap-2 me-2" style="overflow: visible; flex: 1; min-width: 0;">

                                        <!-- Кнопка "+" в плейлист -->
                                        <div class="position-relative" style="overflow: visible;">
                                            <button class="btn btn-sm btn-light p-1 border-0 d-flex align-items-center justify-content-center shadow-none playlist-add-btn"
                                                    type="button"
                                                    onclick="window.togglePlaylistMenu(event, this)"
                                                    style="width: 28px; height: 28px; background: transparent;">
                                                <i class="bi bi-plus-lg fs-5 text-muted" style="pointer-events: none;"></i>
                                            </button>
                                            <div class="bg-white shadow border border-light rounded-3 mt-1 playlist-submenu d-none"
                                                 style="position: absolute; top: 100%; left: 0; z-index: 9999; width: 200px; max-height: 200px; overflow-y: auto;"
                                                 onclick="event.stopPropagation()">
                                                <div class="bg-light px-2 py-1 small text-muted fw-bold border-bottom">Добавить в...</div>
                                                ${currentSongPlaylistsHtml}
                                            </div>
                                        </div>

                                        <!-- Обложка -->
                                        ${cover}

                                        <!-- Название и автор -->
                                        <div class="text-truncate" style="max-width: 250px; flex: 1; min-width: 0;">
                                            <div class="fw-bold small text-dark mb-0 text-truncate">${escapeHtml(song.title)}</div>
                                            <div class="text-muted text-truncate" style="font-size: 0.75rem;">
                                                ${escapeHtml(song.author)} • ${escapeHtml(song.album)}
                                            </div>
                                        </div>
                                    </div>
                                    <span class="text-muted font-monospace small flex-shrink-0">${formatDuration(song.duration)}</span>
                                </div>
                            `;
                        });
                    }
                    searchDropdown.innerHTML = html;
                    showDropdown();
                }

                function showDropdown() {
                    searchDropdown.classList.remove('d-none');
                    searchDropdown.classList.add('d-block');
                }
                function hideDropdown() {
                    searchDropdown.classList.remove('d-block');
                    searchDropdown.classList.add('d-none');
                }

                document.addEventListener('click', function (e) {
                    if (!e.target.closest('.playlist-add-btn') && !e.target.closest('.playlist-submenu')) {
                        document.querySelectorAll('.playlist-submenu').forEach(menu => menu.classList.add('d-none'));
                    }
                    if (!searchContainer.contains(e.target)) {
                        hideDropdown();
                    }
                });

                searchInput.addEventListener('focus', function () {
                    if (this.value.trim().length >= 2 && searchDropdown.innerHTML !== '') {
                        showDropdown();
                    }
                });

                function escapeHtml(str) {
                    if (!str) return '';
                    return String(str).replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;").replace(/"/g, "&quot;").replace(/'/g, "&#039;");
                }
                function formatDuration(durationStr) {
                    if (!durationStr) return '';
                    const parts = durationStr.split(':');
                    if (parts.length === 3) {
                        return parts[0] === "00" ? `${parts[1]}:${parts[2].substring(0,2)}` : durationStr.substring(0,8);
                    }
                    return durationStr;
                }
            });

            // ==================== ГЛОБАЛЬНЫЙ ЗАПУСК ВОСПРОИЗВЕДЕНИЯ ====================
            // Привязываем функции жёстко к window, чтобы HTML точно их увидел
                  window.playSearchSong = function (idx, event) {
            if (event) {
                event.preventDefault();
            }

            console.log("🔥 Клик по треку из поиска! Индекс:", idx);

            // Проверяем и window.PlayerApp, и обычный PlayerApp
            const playerObj = window.PlayerApp || (typeof PlayerApp !== 'undefined' ? PlayerApp : null);

            if (!playerObj) {
                console.error('ОШИБКА: Объект PlayerApp не найден! Проверь, загрузился ли player.js');
                return;
            }

            const songToPlay = window.searchResultsCache[idx];
            console.log("🎵 Загружаем в плеер:", songToPlay);

            // Передаём все найденные треки в качестве текущего плейлиста плеера
            playerObj.setPlaylist(window.searchResultsCache);

            // Запускаем песню
            playerObj.playSongByIndex(idx);
            };

            window.togglePlaylistMenu = function (event, button) {
                event.preventDefault();
                event.stopPropagation(); // Блокируем клик, чтобы песня НЕ начала играть при нажатии на "+"
        
                const submenu = button.nextElementSibling;
                const isCurrentlyHidden = submenu.classList.contains('d-none');
                document.querySelectorAll('.playlist-submenu').forEach(menu => menu.classList.add('d-none'));
                if (isCurrentlyHidden) {
                    submenu.classList.remove('d-none');
                }
            };
    </script>
    @await RenderSectionAsync("Scripts", required: false)</body>
</html>
