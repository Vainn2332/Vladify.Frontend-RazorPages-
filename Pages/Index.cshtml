@page
@model Vladify.Frontend.Pages.IndexModel
@{
    ViewData["Title"] = "Главная";
}

<style>
    .playlist-card {
        cursor: pointer;
        transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);
        position: relative;
        background: #fff;
    }

        .playlist-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 0.5rem 2rem rgba(0,0,0,.15) !important;
        }

    .playlist-cover-placeholder {
        height: 150px;
        transition: filter 0.3s ease;
    }

    /* ФИНАЛЬНАЯ ПАЛИТРА (без дублей) */
    .grad-1 {
        background: linear-gradient(135deg, #FF9A8B 0%, #FF6A88 55%, #FF99AC 100%);
    }
    /* Розовый */
    .grad-2 {
        background: linear-gradient(135deg, #f6d365 0%, #fda085 100%);
    }
    /* Солнечный Оранжевый */
    .grad-3 {
        background: linear-gradient(135deg, #11998e 0%, #38ef7d 100%);
    }
    /* Изумруд */
    .grad-4 {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    }
    /* Индиго */
    .grad-5 {
        background: linear-gradient(135deg, #f093fb 0%, #f5576c 100%);
    }
    /* Ягодный */
    .grad-6 {
        background: linear-gradient(135deg, #4facfe 0%, #00f2fe 100%);
    }
    /* Лазурный */

    /* НОВАЯ ГАРМОНИЧНАЯ КНОПКА (Мятная) */
    .btn-vladify-create {
        background: linear-gradient(135deg, #41d3b7 0%, #27b89d 100%);
        color: white;
        border: none;
        transition: all 0.2s ease;
        font-weight: 500;
    }

        .btn-vladify-create:hover {
            background: linear-gradient(135deg, #51e3c7 0%, #2cccae 100%);
            color: white;
            transform: translateY(-2px);
            box-shadow: 0 4px 12px rgba(39, 184, 157, 0.3) !important;
        }

        .btn-vladify-create:active {
            transform: translateY(0);
        }

    .playlists-grid-container {
        min-height: 540px;
    }

    .card-title {
        font-size: 1rem;
        margin-bottom: 0;
    }

    .playlist-card .card-body {
        padding: 1.25rem 1rem;
        min-height: 70px;
        display: flex;
        align-items: center;
    }

    .pagination .page-link {
        padding: 0.5rem 1.25rem;
    }
</style>

<div class="container-fluid px-4 mt-4">
    <div class="d-flex align-items-center mb-4 gap-3">
        <h2 class="fw-bold h4 mb-0">Мои плейлисты</h2>
        <a asp-page="CreatePlaylist" class="btn btn-vladify-create rounded-pill px-4 shadow-sm btn-sm">
            <i class="bi bi-plus-lg me-1"></i> Создать
        </a>
    </div>

    @if (!Model.Playlists.Any() && Model.CurrentPage == 1)
    {
        <div class="text-center py-5 shadow-sm rounded-4 bg-white">
            <i class="bi bi-music-note-list display-1 text-muted opacity-25"></i>
            <h4 class="mt-3 text-secondary">Здесь пока пусто</h4>
        </div>
    }
    else
    {
        <div class="playlists-grid-container">
            <div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 row-cols-lg-5 g-4">
                @{
                    int i = 0;
                }
                @foreach (var playlist in Model.Playlists)
                {
                    var gradClass = "grad-" + ((i % 6) + 1);
                    i++;

                    <div class="col">
                        <div class="card h-100 border-0 shadow-sm playlist-card rounded-4 overflow-hidden">
                            <div class="playlist-cover-placeholder @gradClass"></div>
                            
                            <div class="card-body">
                                <a asp-page="Playlists" asp-route-id="@playlist.Id" class="stretched-link text-decoration-none">
                                    <h6 class="card-title fw-bold text-dark text-truncate" title="@playlist.Name">
                                        @playlist.Name
                                    </h6>
                                </a>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>

        <nav class="mt-3 pb-5 d-flex justify-content-center">
            <ul class="pagination shadow-sm rounded-pill overflow-hidden border-0">
                <li class="page-item @(Model.CurrentPage <= 1 ? "disabled" : "")">
                    <a class="page-link border-0" asp-page="/Index" asp-route-pageNumber="@(Model.CurrentPage - 1)">
                        <i class="bi bi-chevron-left me-1"></i> Назад
                    </a>
                </li>

                <li class="page-item disabled">
                    <span class="page-link border-0 bg-light text-muted fw-bold">@Model.CurrentPage</span>
                </li>

                @{
                    const int pageSize = 10;
                    var hasNextPage = Model.Playlists.Count() == pageSize;
                }
                <li class="page-item @(!hasNextPage ? "disabled" : "")">
                    <a class="page-link border-0" asp-page="/Index" asp-route-pageNumber="@(Model.CurrentPage + 1)">
                        Вперед <i class="bi bi-chevron-right ms-1"></i>
                    </a>
                </li>
            </ul>
        </nav>
    }
</div>