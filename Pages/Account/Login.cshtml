@page
@model Vladify.Frontend.Pages.Auth.LoginModel
@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Вход в Vladify</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">

    <style>
        :root {
            --bg-main: #f8f9fa;
            --accent: #74b9ff;
            --text: #2d3436;
        }

        body {
            background: linear-gradient(180deg, #C4DFE6 0%, #ffffff 100%);
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            font-family: 'Segoe UI', system-ui, -apple-system, sans-serif;
        }

        .auth-container {
            background: white;
            padding: 3rem;
            border-radius: 24px;
            box-shadow: 0 10px 40px rgba(0,0,0,0.08);
            text-align: center;
            max-width: 460px;
            width: 90%;
            border: 1px solid rgba(0,0,0,0.02);
        }

        .logo-icon {
            font-size: 4rem;
            color: var(--accent);
            margin-bottom: 1rem;
            animation: pulse 2s ease-in-out infinite;
        }

        @@keyframes pulse {
            0%, 100% { transform: scale(1); }
            50% { transform: scale(1.05); }
        }

        .btn-vladify {
            background-color: var(--accent);
            color: white;
            border: none;
            padding: 12px 30px;
            border-radius: 50px;
            font-weight: 600;
            transition: transform 0.2s, box-shadow 0.2s;
            width: 100%;
        }

        .btn-vladify:hover {
            transform: translateY(-2px);
            box-shadow: 0 5px 15px rgba(116, 185, 255, 0.4);
            color: white;
        }

        /* ========== ALERTS ========== */
        .alert-custom {
            border-radius: 16px;
            padding: 18px;
            margin-bottom: 24px;
            text-align: left;
            display: flex;
            align-items: flex-start;
            gap: 14px;
            animation: slideDown 0.4s cubic-bezier(0.4, 0, 0.2, 1);
            border: 1px solid;
        }

        /* Error (red) */
        .alert-error {
            background: linear-gradient(135deg, #fff5f5 0%, #ffe5e5 100%);
            border-color: #ffc9c9;
        }
        .alert-error .alert-icon { color: #e74c3c; }
        .alert-error .alert-title { color: #c0392b; }

        /* Info (green) */
        .alert-info {
            background: linear-gradient(135deg, #e8f5e9 0%, #c8e6c9 100%);
            border-color: #a5d6a7;
        }
        .alert-info .alert-icon { color: #27b89d; }
        .alert-info .alert-title { color: #1e8e7e; }

        /* Warning (orange — для email_not_verified) */
        .alert-warning {
            background: linear-gradient(135deg, #fff8e1 0%, #ffecb3 100%);
            border-color: #ffe082;
        }
        .alert-warning .alert-icon { color: #f39c12; }
        .alert-warning .alert-title { color: #d68910; }

        .alert-icon {
            font-size: 1.8rem;
            flex-shrink: 0;
            margin-top: 2px;
        }

        .alert-content {
            flex: 1;
            min-width: 0;
        }

        .alert-title {
            font-weight: 700;
            margin-bottom: 6px;
            font-size: 1rem;
        }

        .alert-text {
            color: #555;
            font-size: 0.85rem;
            line-height: 1.5;
            margin: 0;
        }

        @@keyframes slideDown {
            from { opacity: 0; transform: translateY(-10px); }
            to { opacity: 1; transform: translateY(0); }
        }

        /* Подсказка для email_not_verified */
        .email-help {
            margin-top: 12px;
            padding-top: 12px;
            border-top: 1px dashed rgba(0,0,0,0.1);
            font-size: 0.78rem;
            color: #888;
        }

        .email-help i {
            color: var(--accent);
            margin-right: 4px;
        }
    </style>
</head>
<body>

    <div class="auth-container">
        <div class="logo-icon">
            <i class="bi bi-vinyl-fill"></i>
        </div>
        <h2 class="fw-bold mb-2" style="color: var(--text)">Vladify</h2>
        <p class="text-muted mb-4">Музыка, которая всегда под рукой. Войдите, чтобы начать прослушивание.</p>

        @* ====== ОТОБРАЖЕНИЕ ОШИБОК ====== *@
        @if (!string.IsNullOrEmpty(Model.ErrorMessage))
        {
            var alertClass = Model.ErrorStyle switch
            {
                "info" => "alert-info",
                "warning" => "alert-warning",
                _ => "alert-error"
            };

            <div class="alert-custom @alertClass" role="alert">
                <i class="bi @Model.ErrorIcon alert-icon"></i>
                <div class="alert-content">
                    <div class="alert-title">@Model.ErrorTitle</div>
                    <p class="alert-text">@Model.ErrorMessage</p>

                    @if (Model.ErrorType == "email_not_verified")
                    {
                        <div class="email-help">
                            <i class="bi bi-info-circle"></i>
                            Не получили письмо? Проверьте папку <strong>«Спам»</strong> или попробуйте войти ещё раз.
                        </div>
                    }
                </div>
            </div>
        }

        <form method="post">
            <input type="hidden" name="returnUrl" value="@Request.Query["ReturnUrl"]" />

            <button type="submit" class="btn btn-vladify btn-lg">
                <i class="bi bi-box-arrow-in-right me-2"></i>
                Войти в аккаунт
            </button>
        </form>

        <div class="mt-4 text-muted small">
            <i class="bi bi-shield-check me-1"></i>
            Безопасный вход через Auth0
        </div>
    </div>

</body>
</html>