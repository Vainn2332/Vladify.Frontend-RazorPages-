@page
@model Vladify.Frontend.Pages.MySongsModel
@{
    ViewData["Title"] = null;
}

<div class="container-fluid px-4 mt-5 pb-player">
    @if (Model.Songs == null)
    {
        <div class="alert alert-soft-warning d-flex align-items-center rounded-4 shadow-sm" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-3 fs-4"></i>
            <div>Автор не найден.</div>
        </div>
        <a asp-page="/Index" class="btn btn-light rounded-pill mt-3">← Назад к медиатеке</a>
    }
    else
    {
        <div class="row align-items-center mb-4">
            <div class="col-auto">
                <div class="playlist-hero-cover grad-grey shadow-lg rounded-4 d-flex align-items-center justify-content-center">
                    <i class="bi bi-music-note-beamed text-white display-1 opacity-50"></i>
                </div>
            </div>
            <div class="col">
                <h1 class="display-4 fw-bold mb-1 mt-0">Мои песни</h1>
            </div>
        </div>

        <div class="d-flex justify-content-between align-items-center mb-4">
            <button class="btn-vladify-play paused shadow-lg" id="mainPlayBtn" onclick="togglePlayAll(this)">
                <svg class="vladify-play-svg vladify-symbol-paused" viewBox="0 0 16 16" width="40" height="40">
                    <path fill="black" d="m11.596 8.697-6.363 3.692c-.54.313-1.233-.066-1.233-.697V4.308c0-.63.692-1.01 1.233-.696l6.363 3.692a.802.802 0 0 1 0 1.393z"/>
                </svg>
                <svg class="vladify-play-svg vladify-symbol-playing" viewBox="0 0 16 16" width="40" height="40">
                    <path fill="black" d="M5.5 3.5A1.5 1.5 0 0 1 7 5v6a1.5 1.5 0 0 1-3 0V5a1.5 1.5 0 0 1 1.5-1.5zm5 0A1.5 1.5 0 0 1 12 5v6a1.5 1.5 0 0 1-3 0V5a1.5 1.5 0 0 1 1.5-1.5z"/>
                </svg>
            </button>

            <button type="button"
                    class="btn btn-vladify-add rounded-pill px-4 py-2 shadow-sm d-flex align-items-center gap-2"
                    data-bs-toggle="modal"
                    data-bs-target="#addSongModal">
                <i class="bi bi-plus-lg"></i>
                <span>Добавить песню</span>
            </button>
        </div>

        <div class="card border-0 shadow-sm rounded-4 overflow-hidden bg-white mb-5">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0 custom-table">
                    <thead class="bg-light text-muted small text-uppercase fw-bold">
                        <tr>
                            <th class="ps-4 py-3" style="width: 50px;">#</th>
                            <th>Название</th>
                            <th>Альбом</th>
                            <th class="text-end"><i class="bi bi-clock"></i></th>
                            <th class="text-end pe-4" style="width: 50px;"></th>
                        </tr>
                    </thead>
                    <tbody>
                        @{ int i = 0; }
                        @foreach (var song in Model.Songs)
                        {
                            <tr class="song-row"
                                data-song-index="@i"
                                data-song-id="@song.Id"
                                data-song-title="@song.Title"
                                data-song-author="@song.Author"
                                data-song-album="@song.Album"
                                data-song-audio="@song.AudioUrl"
                                data-song-image="@song.ImageUrl"
                                data-song-duration="@song.Duration"
                                onclick="onRowClick(@i, event)">
                                <td class="ps-4 text-muted song-row-number">
                                    <span class="row-num">@(i + 1)</span>
                                    <i class="bi bi-play-fill row-play-icon"></i>
                                    <i class="bi bi-pause-fill row-pause-icon"></i>
                                </td>
                                <td>
                                    <div class="d-flex align-items-center">
                                        @if (!string.IsNullOrEmpty(song.ImageUrl))
                                        {
                                            <img src="@song.ImageUrl"
                                                 alt="@song.Title"
                                                 class="song-cover-img me-3 rounded shadow-sm" />
                                        }
                                        else
                                        {
                                            <div class="song-icon-placeholder me-3 rounded shadow-sm d-flex align-items-center justify-content-center">
                                                <i class="bi bi-music-note text-accent"></i>
                                            </div>
                                        }
                                        <div>
                                            <div class="fw-bold song-title">@song.Title</div>
                                            <div class="text-muted small">@song.Author</div>
                                        </div>
                                    </div>
                                </td>
                                <td class="text-muted small">@song.Album</td>
                                <td class="text-end text-muted small mono">
                                    @FormatDuration(song.Duration)
                                </td>
                                <td class="text-end pe-4">
                                    <button type="button"
                                            class="btn-delete-song"
                                            title="Удалить"
                                            data-bs-toggle="modal"
                                            data-bs-target="#confirmDeleteModal"
                                            data-song-id="@song.Id"
                                            data-song-title="@song.Title"
                                            onclick="event.stopPropagation()">
                                        <i class="bi bi-trash3"></i>
                                    </button>
                                </td>
                            </tr>
                            i++;
                        }
                    </tbody>
                </table>
            </div>
            @if (!Model.Songs.Any())
            {
                <div class="text-center py-5">
                    <p class="text-muted fs-5">Здесь пока ничего нет.</p>
                </div>
            }
        </div>
    }

    <!-- Модалка удаления -->
    <div class="modal fade" id="confirmDeleteModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered" style="max-width: 400px;">
            <div class="modal-content border-0 shadow-lg rounded-4">
                <div class="modal-body p-4 text-center">
                    <div class="mb-3">
                        <i class="bi bi-exclamation-circle display-3 opacity-75" style="color: #cca4a4;"></i>
                    </div>
                    <h4 class="fw-bold mb-2">Удалить песню?</h4>
                    <p class="text-muted mb-4">
                        Вы уверены, что хотите удалить песню
                        <strong id="songTitleToDelete"></strong>?
                    </p>
                    <div class="d-grid gap-2">
                        <form method="post" asp-page-handler="DeleteSong" id="deleteSongForm">
                            <input type="hidden" name="songId" id="songIdToDelete" />
                            <button type="submit" class="btn btn-soft-confirm w-100 rounded-pill py-2 fw-bold">
                                Да, удалить песню
                            </button>
                        </form>
                        <button type="button" class="btn btn-light w-100 rounded-pill py-2 text-muted shadow-none" data-bs-dismiss="modal">
                            Отмена
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Модалка добавления -->
    <div class="modal fade" id="addSongModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered" style="max-width: 560px;">
            <div class="modal-content border-0 shadow-lg rounded-4">
                <form method="post" asp-page-handler="CreateSong" enctype="multipart/form-data">
                    <div class="modal-header border-0 pb-0">
                        <h4 class="modal-title fw-bold">Добавить песню</h4>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body pt-3">
                        <div class="mb-3">
                            <label asp-for="SongAddRequestModel.Title" class="form-label fw-semibold">Название</label>
                            <input asp-for="SongAddRequestModel.Title" class="form-control rounded-3" placeholder="Например: Midnight Drive" required />
                            <span asp-validation-for="SongAddRequestModel.Title" class="text-danger small"></span>
                        </div>
                        <div class="mb-3">
                            <label asp-for="SongAddRequestModel.Album" class="form-label fw-semibold">Альбом</label>
                            <input asp-for="SongAddRequestModel.Album" class="form-control rounded-3" placeholder="Например: City Lights" required />
                            <span asp-validation-for="SongAddRequestModel.Album" class="text-danger small"></span>
                        </div>
                        <div class="mb-4">
                            <label asp-for="SongAddRequestModel.Duration" class="form-label fw-semibold">Длительность</label>
                            <input asp-for="SongAddRequestModel.Duration" type="time" step="1" class="form-control rounded-3" required />
                            <span asp-validation-for="SongAddRequestModel.Duration" class="text-danger small"></span>
                            <div class="form-text">Формат: <code>mm:ss</code> или <code>hh:mm:ss</code></div>
                        </div>
                        <div class="mb-4">
                            <label class="form-label fw-semibold">Обложка трека</label>
                            <div class="upload-drop-zone" id="imageDropZone">
                                <input type="file" asp-for="SongAddRequestModel.Image" accept="image/png,image/jpeg,image/webp" class="upload-file-input" id="imageFileInput" required />
                                <div class="upload-placeholder" id="imagePlaceholder">
                                    <div class="upload-icon-circle mb-2"><i class="bi bi-image"></i></div>
                                    <div class="fw-semibold text-dark small">Перетащите изображение сюда</div>
                                    <div class="text-muted" style="font-size:.75rem">или нажмите • PNG, JPG, WEBP</div>
                                </div>
                                <div class="upload-preview d-none" id="imagePreview">
                                    <img id="imagePreviewImg" src="" alt="" class="upload-preview-img" />
                                    <div class="upload-file-info">
                                        <div class="fw-semibold text-dark small text-truncate" id="imageFileName"></div>
                                        <div class="text-muted" style="font-size:.7rem" id="imageFileSize"></div>
                                    </div>
                                    <button type="button" class="btn-upload-remove" id="imageRemoveBtn"><i class="bi bi-x-lg"></i></button>
                                </div>
                            </div>
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-semibold">Аудиофайл</label>
                            <div class="upload-drop-zone" id="audioDropZone">
                                <input type="file" asp-for="SongAddRequestModel.AudioFile" accept="audio/mpeg,audio/wav,audio/ogg,audio/flac" class="upload-file-input" id="audioFileInput" required />
                                <div class="upload-placeholder" id="audioPlaceholder">
                                    <div class="upload-icon-circle audio mb-2"><i class="bi bi-music-note-beamed"></i></div>
                                    <div class="fw-semibold text-dark small">Перетащите аудиофайл сюда</div>
                                    <div class="text-muted" style="font-size:.75rem">или нажмите • MP3, WAV, OGG, FLAC</div>
                                </div>
                                <div class="upload-preview d-none" id="audioPreview">
                                    <div class="upload-audio-icon-mini"><i class="bi bi-file-earmark-music-fill"></i></div>
                                    <div class="upload-file-info">
                                        <div class="fw-semibold text-dark small text-truncate" id="audioFileName"></div>
                                        <div class="text-muted" style="font-size:.7rem" id="audioFileSize"></div>
                                    </div>
                                    <button type="button" class="btn-upload-remove" id="audioRemoveBtn"><i class="bi bi-x-lg"></i></button>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="modal-footer border-0 pt-0 justify-content-center gap-3">
                        <button type="submit" class="btn btn-vladify-save rounded-pill py-2 m-0 text-white fw-bold" style="width:150px">Сохранить</button>
                        <button type="button" class="btn btn-light rounded-pill px-4 py-2 m-0 text-muted" data-bs-dismiss="modal">Отмена</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<!-- ============ PLAYER BAR ============ -->
<div class="player-bar" id="playerBar">
    <div class="player-inner">
        <!-- Left -->
        <div class="player-left">
            <img src="" alt="" class="player-cover" id="playerCover" />
            <div class="player-song-info">
                <div class="player-song-title" id="playerTitle">—</div>
                <div class="player-song-author" id="playerAuthor">—</div>
            </div>
        </div>

        <!-- Center -->
        <div class="player-center">
            <div class="player-controls">
                <button class="player-ctrl-btn" id="btnPrev" onclick="playPrev()" title="Предыдущая">
                    <i class="bi bi-skip-start-fill"></i>
                </button>
                <button class="player-ctrl-btn play-pause-btn" id="btnPlayPause" onclick="togglePlayPause()" title="Воспроизвести">
                    <i class="bi bi-play-fill" id="iconPlay"></i>
                    <i class="bi bi-pause-fill d-none" id="iconPause"></i>
                </button>
                <button class="player-ctrl-btn" id="btnNext" onclick="playNext()" title="Следующая">
                    <i class="bi bi-skip-end-fill"></i>
                </button>
            </div>
            <div class="player-progress-row">
                <span class="player-time" id="playerCurrentTime">0:00</span>
                <div class="player-progress-bar" id="progressBarContainer">
                    <div class="player-progress-bg">
                        <div class="player-progress-fill" id="progressFill"></div>
                    </div>
                    <div class="player-progress-thumb" id="progressThumb"></div>
                </div>
                <span class="player-time" id="playerDuration">0:00</span>
            </div>
        </div>

        <!-- Right -->
        <div class="player-right">
            <button class="player-ctrl-btn" id="btnVolume" onclick="toggleMute()" title="Громкость">
                <i class="bi bi-volume-up-fill" id="iconVolumeUp"></i>
                <i class="bi bi-volume-mute-fill d-none" id="iconVolumeMute"></i>
            </button>
            <div class="player-volume-bar" id="volumeBarContainer">
                <div class="player-volume-bg">
                    <div class="player-volume-fill" id="volumeFill" style="width:100%"></div>
                </div>
                <div class="player-volume-thumb" id="volumeThumb" style="left:100%"></div>
            </div>
        </div>
    </div>
    <audio id="audioPlayer" preload="metadata"></audio>
</div>

@functions {
    private string FormatDuration(TimeSpan duration)
    {
        if (duration.TotalHours >= 1)
            return duration.ToString(@"hh\:mm\:ss");
        return duration.ToString(@"mm\:ss");
    }
}

@section Scripts {
    <script>
        // ==================== STATE ====================
        const audio = document.getElementById('audioPlayer');
        let currentIndex = -1;
        let savedVolume = 1;

        const songRows = document.querySelectorAll('.song-row[data-song-audio]');
        const songs = Array.from(songRows).map((row, idx) => ({
            index: idx,
            id: row.dataset.songId,
            title: row.dataset.songTitle,
            author: row.dataset.songAuthor,
            album: row.dataset.songAlbum,
            audioUrl: row.dataset.songAudio,
            imageUrl: row.dataset.songImage,
            duration: row.dataset.songDuration
        }));

        // ==================== ROW CLICK ====================
        function onRowClick(idx, event) {
            // Если кликнули по той же песне которая играет — ставим на паузу
            if (idx === currentIndex && !audio.paused) {
                audio.pause();
                showPlayIcon();
                syncMainPlayBtn(false);
                highlightRow(currentIndex);
                return;
            }
            // Если кликнули по той же песне которая на паузе — продолжаем
            if (idx === currentIndex && audio.paused) {
                audio.play();
                showPauseIcon();
                syncMainPlayBtn(true);
                highlightRow(currentIndex);
                return;
            }
            // Новая песня
            playSongByIndex(idx);
        }

        // ==================== PLAY SONG ====================
        function playSongByIndex(idx) {
            if (idx < 0 || idx >= songs.length) return;

            const song = songs[idx];
            currentIndex = idx;

            audio.src = song.audioUrl;
            audio.play();

            document.getElementById('playerCover').src = song.imageUrl || '';
            document.getElementById('playerTitle').textContent = song.title;
            document.getElementById('playerAuthor').textContent = song.author;

            document.getElementById('playerBar').classList.add('visible');

            showPauseIcon();
            highlightRow(idx);
            syncMainPlayBtn(true);
        }

        // ==================== CONTROLS ====================
        function togglePlayPause() {
            if (audio.paused) {
                if (!audio.src || audio.src === window.location.href) {
                    if (songs.length > 0) playSongByIndex(0);
                    return;
                }
                audio.play();
                showPauseIcon();
                syncMainPlayBtn(true);
            } else {
                audio.pause();
                showPlayIcon();
                syncMainPlayBtn(false);
            }
            highlightRow(currentIndex);
        }

        function playNext() {
            if (songs.length === 0) return;
            let next = currentIndex + 1;
            if (next >= songs.length) next = 0;
            playSongByIndex(next);
        }

        function playPrev() {
            if (songs.length === 0) return;
            if (audio.currentTime > 3) {
                audio.currentTime = 0;
                return;
            }
            let prev = currentIndex - 1;
            if (prev < 0) prev = songs.length - 1;
            playSongByIndex(prev);
        }

        function togglePlayAll(button) {
            if (audio.paused || currentIndex < 0) {
                if (currentIndex < 0 && songs.length > 0) {
                    playSongByIndex(0);
                } else {
                    audio.play();
                    showPauseIcon();
                }
                syncMainPlayBtn(true);
            } else {
                audio.pause();
                showPlayIcon();
                syncMainPlayBtn(false);
            }
            highlightRow(currentIndex);
        }

        // ==================== PROGRESS ====================
        audio.addEventListener('timeupdate', () => {
            if (!audio.duration) return;
            const pct = (audio.currentTime / audio.duration) * 100;
            document.getElementById('progressFill').style.width = pct + '%';
            document.getElementById('progressThumb').style.left = pct + '%';
            document.getElementById('playerCurrentTime').textContent = formatTime(audio.currentTime);
        });

        audio.addEventListener('loadedmetadata', () => {
            document.getElementById('playerDuration').textContent = formatTime(audio.duration);
        });

        audio.addEventListener('ended', () => {
            playNext();
        });

        function seekTo(e) {
            const bar = document.getElementById('progressBarContainer');
            const rect = bar.getBoundingClientRect();
            const pct = Math.max(0, Math.min(1, (e.clientX - rect.left) / rect.width));
            if (audio.duration) audio.currentTime = pct * audio.duration;
        }

        (function () {
            const bar = document.getElementById('progressBarContainer');
            let dragging = false;
            bar.addEventListener('mousedown', e => { dragging = true; seekTo(e); });
            document.addEventListener('mousemove', e => { if (dragging) seekTo(e); });
            document.addEventListener('mouseup', () => { dragging = false; });
        })();

        // ==================== VOLUME ====================
        function setVolume(e) {
            const bar = document.getElementById('volumeBarContainer');
            const rect = bar.getBoundingClientRect();
            const pct = Math.max(0, Math.min(1, (e.clientX - rect.left) / rect.width));
            audio.volume = pct;
            savedVolume = pct;
            updateVolumeUI(pct);
        }

        function toggleMute() {
            if (audio.volume > 0) {
                savedVolume = audio.volume;
                audio.volume = 0;
                updateVolumeUI(0);
            } else {
                audio.volume = savedVolume || 1;
                updateVolumeUI(audio.volume);
            }
        }

        function updateVolumeUI(vol) {
            document.getElementById('volumeFill').style.width = (vol * 100) + '%';
            document.getElementById('volumeThumb').style.left = (vol * 100) + '%';
            document.getElementById('iconVolumeUp').classList.toggle('d-none', vol === 0);
            document.getElementById('iconVolumeMute').classList.toggle('d-none', vol > 0);
        }

        (function () {
            const bar = document.getElementById('volumeBarContainer');
            let dragging = false;
            bar.addEventListener('mousedown', e => { dragging = true; setVolume(e); });
            document.addEventListener('mousemove', e => { if (dragging) setVolume(e); });
            document.addEventListener('mouseup', () => { dragging = false; });
        })();

        // ==================== HELPERS ====================
        function formatTime(sec) {
            if (!sec || isNaN(sec)) return '0:00';
            const m = Math.floor(sec / 60);
            const s = Math.floor(sec % 60);
            return m + ':' + (s < 10 ? '0' : '') + s;
        }

        function showPlayIcon() {
            document.getElementById('iconPlay').classList.remove('d-none');
            document.getElementById('iconPause').classList.add('d-none');
        }

        function showPauseIcon() {
            document.getElementById('iconPlay').classList.add('d-none');
            document.getElementById('iconPause').classList.remove('d-none');
        }

        function highlightRow(idx) {
            songRows.forEach(row => {
                const i = parseInt(row.dataset.songIndex);
                const isActive = i === idx;
                const isPlaying = isActive && !audio.paused;
                row.classList.toggle('active-song', isActive);
                row.classList.toggle('playing-song', isPlaying);
                row.classList.toggle('paused-song', isActive && audio.paused);
            });
        }

        function syncMainPlayBtn(playing) {
            const btn = document.getElementById('mainPlayBtn');
            if (!btn) return;
            btn.classList.toggle('playing', playing);
            btn.classList.toggle('paused', !playing);
        }

        // ==================== DELETE MODAL ====================
        const confirmDeleteModal = document.getElementById('confirmDeleteModal');
        confirmDeleteModal.addEventListener('show.bs.modal', function (event) {
            const button = event.relatedTarget;
            document.getElementById('songIdToDelete').value = button.getAttribute('data-song-id');
            document.getElementById('songTitleToDelete').textContent = button.getAttribute('data-song-title');
        });

        // ==================== UPLOAD ====================
        function formatFileSize(bytes) {
            if (bytes < 1024) return bytes + ' B';
            if (bytes < 1048576) return (bytes / 1024).toFixed(1) + ' KB';
            return (bytes / 1048576).toFixed(1) + ' MB';
        }

        function setupUploadZone({ dropZoneId, inputId, placeholderId, previewId, removeBtnId, fileNameId, fileSizeId, previewImgId }) {
            const dropZone = document.getElementById(dropZoneId);
            const input = document.getElementById(inputId);
            const placeholder = document.getElementById(placeholderId);
            const preview = document.getElementById(previewId);
            const removeBtn = document.getElementById(removeBtnId);
            const fileNameEl = document.getElementById(fileNameId);
            const fileSizeEl = document.getElementById(fileSizeId);
            const previewImg = previewImgId ? document.getElementById(previewImgId) : null;

            function showFile(file) {
                fileNameEl.textContent = file.name;
                fileSizeEl.textContent = formatFileSize(file.size);
                placeholder.classList.add('d-none');
                preview.classList.remove('d-none');
                dropZone.classList.add('has-file');
                if (previewImg && file.type.startsWith('image/')) {
                    const reader = new FileReader();
                    reader.onload = e => previewImg.src = e.target.result;
                    reader.readAsDataURL(file);
                }
            }

            function clearFile() {
                input.value = '';
                placeholder.classList.remove('d-none');
                preview.classList.add('d-none');
                dropZone.classList.remove('has-file');
                if (previewImg) previewImg.src = '';
            }

            input.addEventListener('change', () => { if (input.files.length > 0) showFile(input.files[0]); });
            removeBtn.addEventListener('click', e => { e.preventDefault(); e.stopPropagation(); clearFile(); });

            ['dragenter', 'dragover'].forEach(evt => dropZone.addEventListener(evt, e => { e.preventDefault(); dropZone.classList.add('drag-over'); }));
            ['dragleave', 'drop'].forEach(evt => dropZone.addEventListener(evt, e => { e.preventDefault(); dropZone.classList.remove('drag-over'); }));
            dropZone.addEventListener('drop', e => { if (e.dataTransfer.files.length > 0) { input.files = e.dataTransfer.files; showFile(e.dataTransfer.files[0]); } });
        }

        setupUploadZone({ dropZoneId:'imageDropZone', inputId:'imageFileInput', placeholderId:'imagePlaceholder', previewId:'imagePreview', removeBtnId:'imageRemoveBtn', fileNameId:'imageFileName', fileSizeId:'imageFileSize', previewImgId:'imagePreviewImg' });
        setupUploadZone({ dropZoneId:'audioDropZone', inputId:'audioFileInput', placeholderId:'audioPlaceholder', previewId:'audioPreview', removeBtnId:'audioRemoveBtn', fileNameId:'audioFileName', fileSizeId:'audioFileSize', previewImgId:null });

        document.getElementById('addSongModal').addEventListener('hidden.bs.modal', function () {
            this.querySelector('form').reset();
            ['imagePlaceholder','audioPlaceholder'].forEach(id => document.getElementById(id).classList.remove('d-none'));
            ['imagePreview','audioPreview'].forEach(id => document.getElementById(id).classList.add('d-none'));
            ['imageDropZone','audioDropZone'].forEach(id => document.getElementById(id).classList.remove('has-file'));
            document.getElementById('imagePreviewImg').src = '';
        });
    </script>
}

<style>
    :root {
        --accent-color: #74b9ff;
        --vladify-green: #41d3b7;
