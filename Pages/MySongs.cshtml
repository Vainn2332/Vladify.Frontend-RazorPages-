@page
@model Vladify.Frontend.Pages.MySongsModel
@{
     ViewData["Title"] = null;
}

<div class="container-fluid px-4 mt-5">
    @if (Model.Songs == null)
    {
        <div class="alert alert-soft-warning d-flex align-items-center rounded-4 shadow-sm" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-3 fs-4"></i>
            <div>Автор не найден.</div>
        </div>
        <a asp-page="/Index" class="btn btn-light rounded-pill mt-3">← Назад к медиатеке</a>
    }
    else
    {
        <div class="row align-items-center mb-4">
            <div class="col-auto">
                <div class="playlist-hero-cover grad-grey shadow-lg rounded-4 d-flex align-items-center justify-content-center">
                    <i class="bi bi-music-note-beamed text-white display-1 opacity-50"></i>
                </div>
            </div>
            <div class="col">
                <h1 class="display-4 fw-bold mb-1 mt-0">Мои песни</h1>
            </div>
        </div>

        <div class="d-flex justify-content-between align-items-center mb-4">
            <button class="btn-vladify-play paused shadow-lg" onclick="togglePlayMain(this)">
                <svg class="vladify-play-svg vladify-symbol-paused" viewBox="0 0 16 16" width="40" height="40">
                  <path fill="black" d="m11.596 8.697-6.363 3.692c-.54.313-1.233-.066-1.233-.697V4.308c0-.63.692-1.01 1.233-.696l6.363 3.692a.802.802 0 0 1 0 1.393z"/>
                </svg>
                <svg class="vladify-play-svg vladify-symbol-playing" viewBox="0 0 16 16" width="40" height="40">
                  <path fill="black" d="M5.5 3.5A1.5 1.5 0 0 1 7 5v6a1.5 1.5 0 0 1-3 0V5a1.5 1.5 0 0 1 1.5-1.5zm5 0A1.5 1.5 0 0 1 12 5v6a1.5 1.5 0 0 1-3 0V5a1.5 1.5 0 0 1 1.5-1.5z"/>
                </svg>
            </button>
            
            <button type="button" 
                    class="btn btn-vladify-add rounded-pill px-4 py-2 shadow-sm d-flex align-items-center gap-2"
                    data-bs-toggle="modal" 
                    data-bs-target="#addSongModal">
                <i class="bi bi-plus-lg"></i>
                <span>Добавить песню</span>
            </button>
        </div>

        <div class="card border-0 shadow-sm rounded-4 overflow-hidden bg-white mb-5">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0 custom-table">
                    <thead class="bg-light text-muted small text-uppercase fw-bold">
                        <tr>
                            <th class="ps-4 py-3" style="width: 50px;">#</th>
                            <th>Название</th>
                            <th>Альбом</th>
                            <th class="text-end"><i class="bi bi-clock"></i></th>
                            <th class="text-end pe-4" style="width: 50px;"></th>
                        </tr>
                    </thead>
                    <tbody>
    @{ int i = 1; }
    @foreach (var song in Model.Songs)
    {
        <tr class="song-row">
            <td class="ps-4 text-muted">@i</td>
            <td>
                <div class="d-flex align-items-center">
                    @if (!string.IsNullOrEmpty(song.ImageUrl))
                    {
                        <img src="@song.ImageUrl" 
                             alt="@song.Title" 
                             class="song-cover-img me-3 rounded shadow-sm" />
                    }
                    else
                    {
                        <div class="song-icon-placeholder me-3 rounded shadow-sm d-flex align-items-center justify-content-center">
                            <i class="bi bi-music-note text-accent"></i>
                        </div>
                    }
                    <div>
                        <div class="fw-bold song-title">@song.Title</div>
                        <div class="text-muted small">@song.Author</div>
                    </div>
                </div>
            </td>
            <td class="text-muted small">@song.Album</td>
            <td class="text-end text-muted small mono">
                @FormatDuration(song.Duration)
            </td>
            <td class="text-end pe-4">
                <button type="button" 
                        class="btn-delete-song" 
                        title="Удалить"
                        data-bs-toggle="modal" 
                        data-bs-target="#confirmDeleteModal"
                        data-song-id="@song.Id"
                        data-song-title="@song.Title">
                    <i class="bi bi-trash3"></i>
                </button>
            </td>
        </tr>
        i++;
    }
</tbody>
                </table>
            </div>
            @if (!Model.Songs.Any())
            {
                <div class="text-center py-5">
                    <p class="text-muted fs-5">Здесь пока ничего нет.</p>
                </div>
            }
        </div>
    }

    <!-- Модалка удаления -->
    <div class="modal fade" id="confirmDeleteModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered" style="max-width: 400px;">
            <div class="modal-content border-0 shadow-lg rounded-4">
                <div class="modal-body p-4 text-center">
                    <div class="mb-3">
                        <i class="bi bi-exclamation-circle display-3 opacity-75" style="color: #cca4a4;"></i>
                    </div>
                    <h4 class="fw-bold mb-2">Удалить песню?</h4>
                    <p class="text-muted mb-4">
                       Вы уверены, что хотите удалить песню 
                       <strong id="songTitleToDelete"></strong>?
                    </p>
                    <div class="d-grid gap-2">
                        <form method="post" asp-page-handler="DeleteSong" id="deleteSongForm">
                            <input type="hidden" name="songId" id="songIdToDelete" />
                            <button type="submit" class="btn btn-soft-confirm w-100 rounded-pill py-2 fw-bold">
                                Да, удалить песню
                            </button>
                        </form>
                        <button type="button" class="btn btn-light w-100 rounded-pill py-2 text-muted shadow-none" data-bs-dismiss="modal">
                            Отмена
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Модалка добавления песни -->
    <div class="modal fade" id="addSongModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered" style="max-width: 560px;">
            <div class="modal-content border-0 shadow-lg rounded-4">
                <form method="post" asp-page-handler="CreateSong" enctype="multipart/form-data">
                    <div class="modal-header border-0 pb-0">
                        <h4 class="modal-title fw-bold">Добавить песню</h4>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body pt-3">
                        <!-- Название -->
                        <div class="mb-3">
                            <label asp-for="SongAddRequestModel.Title" class="form-label fw-semibold">Название</label>
                            <input asp-for="SongAddRequestModel.Title" class="form-control rounded-3" placeholder="Например: Midnight Drive" required />
                            <span asp-validation-for="SongAddRequestModel.Title" class="text-danger small"></span>
                        </div>

                        <!-- Альбом -->
                        <div class="mb-3">
                            <label asp-for="SongAddRequestModel.Album" class="form-label fw-semibold">Альбом</label>
                            <input asp-for="SongAddRequestModel.Album" class="form-control rounded-3" placeholder="Например: City Lights" required />
                            <span asp-validation-for="SongAddRequestModel.Album" class="text-danger small"></span>
                        </div>

                        <!-- Длительность -->
                        <div class="mb-4">
                            <label asp-for="SongAddRequestModel.Duration" class="form-label fw-semibold">Длительность</label>
                            <input asp-for="SongAddRequestModel.Duration" type="time" step="1" class="form-control rounded-3" style="cursor:text" placeholder="mm:ss" required />
                            <span asp-validation-for="SongAddRequestModel.Duration" class="text-danger small"></span>
                            <div class="form-text">Формат: <code>mm:ss</code> или <code>hh:mm:ss</code></div>
                        </div>

                        <!-- Обложка -->
                        <div class="mb-4">
                            <label class="form-label fw-semibold">Обложка трека</label>
                            <div class="upload-drop-zone" id="imageDropZone">
                                <input type="file" 
                                       asp-for="SongAddRequestModel.Image" 
                                       accept="image/png, image/jpeg, image/webp" 
                                       class="upload-file-input" 
                                       id="imageFileInput"
                                       required />
                                <div class="upload-placeholder" id="imagePlaceholder">
                                    <div class="upload-icon-circle mb-2">
                                        <i class="bi bi-image"></i>
                                    </div>
                                    <div class="fw-semibold text-dark small">Перетащите изображение сюда</div>
                                    <div class="text-muted" style="font-size: 0.75rem;">или нажмите для выбора • PNG, JPG, WEBP</div>
                                </div>
                                <div class="upload-preview d-none" id="imagePreview">
                                    <img id="imagePreviewImg" src="" alt="preview" class="upload-preview-img" />
                                    <div class="upload-file-info">
                                        <div class="fw-semibold text-dark small text-truncate" id="imageFileName"></div>
                                        <div class="text-muted" style="font-size: 0.7rem;" id="imageFileSize"></div>
                                    </div>
                                    <button type="button" class="btn-upload-remove" id="imageRemoveBtn" title="Удалить">
                                        <i class="bi bi-x-lg"></i>
                                    </button>
                                </div>
                            </div>
                            <span asp-validation-for="SongAddRequestModel.Image" class="text-danger small"></span>
                        </div>

                        <!-- Аудиофайл -->
                        <div class="mb-3">
                            <label class="form-label fw-semibold">Аудиофайл</label>
                            <div class="upload-drop-zone" id="audioDropZone">
                                <input type="file" 
                                       asp-for="SongAddRequestModel.AudioFile" 
                                       accept="audio/mpeg, audio/wav, audio/ogg, audio/flac" 
                                       class="upload-file-input" 
                                       id="audioFileInput"
                                       required />
                                <div class="upload-placeholder" id="audioPlaceholder">
                                    <div class="upload-icon-circle audio mb-2">
                                        <i class="bi bi-music-note-beamed"></i>
                                    </div>
                                    <div class="fw-semibold text-dark small">Перетащите аудиофайл сюда</div>
                                    <div class="text-muted" style="font-size: 0.75rem;">или нажмите для выбора • MP3, WAV, OGG, FLAC</div>
                                </div>
                                <div class="upload-preview d-none" id="audioPreview">
                                    <div class="upload-audio-icon-mini">
                                        <i class="bi bi-file-earmark-music-fill"></i>
                                    </div>
                                    <div class="upload-file-info">
                                        <div class="fw-semibold text-dark small text-truncate" id="audioFileName"></div>
                                        <div class="text-muted" style="font-size: 0.7rem;" id="audioFileSize"></div>
                                    </div>
                                    <button type="button" class="btn-upload-remove" id="audioRemoveBtn" title="Удалить">
                                        <i class="bi bi-x-lg"></i>
                                    </button>
                                </div>
                            </div>
                            <span asp-validation-for="SongAddRequestModel.AudioFile" class="text-danger small"></span>
                        </div>
                    </div>
                    
                    <div class="modal-footer border-0 pt-0 justify-content-center gap-3">
                        <button type="submit" class="btn btn-vladify-save rounded-pill py-2 m-0 text-white fw-bold" style="width: 150px;">
                            Сохранить
                        </button>
                        <button type="button" class="btn btn-light rounded-pill px-4 py-2 m-0 text-muted" data-bs-dismiss="modal">
                            Отмена
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@functions {
    private string FormatDuration(TimeSpan duration)
    {
        if (duration.TotalHours >= 1)
            return duration.ToString(@"hh\:mm\:ss");
        return duration.ToString(@"mm\:ss");
    }
}

@section Scripts {
    <script>
        // Play button
        function togglePlayMain(button) {
            button.classList.toggle('playing');
            button.classList.toggle('paused');
        }

        // Delete modal
        const confirmDeleteModal = document.getElementById('confirmDeleteModal');
        confirmDeleteModal.addEventListener('show.bs.modal', function (event) {
            const button = event.relatedTarget;
            document.getElementById('songIdToDelete').value = button.getAttribute('data-song-id');
            document.getElementById('songTitleToDelete').textContent = button.getAttribute('data-song-title');
        });

        // ========== Upload helpers ==========
        function formatFileSize(bytes) {
            if (bytes < 1024) return bytes + ' B';
            if (bytes < 1048576) return (bytes / 1024).toFixed(1) + ' KB';
            return (bytes / 1048576).toFixed(1) + ' MB';
        }

        function setupUploadZone({ dropZoneId, inputId, placeholderId, previewId, removeBtnId, fileNameId, fileSizeId, previewImgId }) {
            const dropZone = document.getElementById(dropZoneId);
            const input = document.getElementById(inputId);
            const placeholder = document.getElementById(placeholderId);
            const preview = document.getElementById(previewId);
            const removeBtn = document.getElementById(removeBtnId);
            const fileNameEl = document.getElementById(fileNameId);
            const fileSizeEl = document.getElementById(fileSizeId);
            const previewImg = previewImgId ? document.getElementById(previewImgId) : null;

            function showFile(file) {
                fileNameEl.textContent = file.name;
                fileSizeEl.textContent = formatFileSize(file.size);
                placeholder.classList.add('d-none');
                preview.classList.remove('d-none');
                dropZone.classList.add('has-file');

                if (previewImg && file.type.startsWith('image/')) {
                    const reader = new FileReader();
                    reader.onload = e => previewImg.src = e.target.result;
                    reader.readAsDataURL(file);
                }
            }

            function clearFile() {
                input.value = '';
                placeholder.classList.remove('d-none');
                preview.classList.add('d-none');
                dropZone.classList.remove('has-file');
                if (previewImg) previewImg.src = '';
            }

            input.addEventListener('change', () => {
                if (input.files.length > 0) showFile(input.files[0]);
            });

            removeBtn.addEventListener('click', e => {
                e.preventDefault();
                e.stopPropagation();
                clearFile();
            });

            // Drag & Drop
            ['dragenter', 'dragover'].forEach(evt => {
                dropZone.addEventListener(evt, e => {
                    e.preventDefault();
                    dropZone.classList.add('drag-over');
                });
            });
            ['dragleave', 'drop'].forEach(evt => {
                dropZone.addEventListener(evt, e => {
                    e.preventDefault();
                    dropZone.classList.remove('drag-over');
                });
            });
            dropZone.addEventListener('drop', e => {
                const files = e.dataTransfer.files;
                if (files.length > 0) {
                    input.files = files;
                    showFile(files[0]);
                }
            });
        }

        // Image upload zone
        setupUploadZone({
            dropZoneId: 'imageDropZone',
            inputId: 'imageFileInput',
            placeholderId: 'imagePlaceholder',
            previewId: 'imagePreview',
            removeBtnId: 'imageRemoveBtn',
            fileNameId: 'imageFileName',
            fileSizeId: 'imageFileSize',
            previewImgId: 'imagePreviewImg'
        });

        // Audio upload zone
        setupUploadZone({
            dropZoneId: 'audioDropZone',
            inputId: 'audioFileInput',
            placeholderId: 'audioPlaceholder',
            previewId: 'audioPreview',
            removeBtnId: 'audioRemoveBtn',
            fileNameId: 'audioFileName',
            fileSizeId: 'audioFileSize',
            previewImgId: null
        });

        // Reset on modal close
        document.getElementById('addSongModal').addEventListener('hidden.bs.modal', function () {
            const form = this.querySelector('form');
            form.reset();
            // Reset image
            document.getElementById('imagePlaceholder').classList.remove('d-none');
            document.getElementById('imagePreview').classList.add('d-none');
            document.getElementById('imageDropZone').classList.remove('has-file');
            document.getElementById('imagePreviewImg').src = '';
            // Reset audio
            document.getElementById('audioPlaceholder').classList.remove('d-none');
            document.getElementById('audioPreview').classList.add('d-none');
            document.getElementById('audioDropZone').classList.remove('has-file');
        });
    </script>
}

<style>
    :root {
        --accent-color: #74b9ff;
        --vladify-btn-grad: linear-gradient(135deg, #41d3b7 0%, #27b89d 100%);
        --vladify-btn-hover: linear-gradient(135deg, #51e3c7 0%, #2cccae 100%);
    }

    .playlist-hero-cover {
        width: 170px;
        height: 170px;
    }

    .btn-vladify-play {
        width: 64px; height: 64px; border-radius: 50%;
        background: var(--vladify-btn-grad); border: none;
        display: flex; align-items: center; justify-content: center;
        transition: all 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275);
    }
    .vladify-play-svg { display: none; width: 40px; height: 40px; }
    .btn-vladify-play.paused .vladify-symbol-paused { display: block; margin-left: 5px; }
    .btn-vladify-play.playing .vladify-symbol-playing { display: block; }
    .btn-vladify-play:hover {
        transform: scale(1.1); background: var(--vladify-btn-hover);
        box-shadow: 0 8px 20px rgba(39, 184, 157, 0.4) !important;
    }
    .btn-vladify-play:active { transform: scale(0.95); }

    .custom-table thead th { border-bottom: none; font-size: 0.7rem; color: #adb5bd; }
    .song-row { cursor: pointer; transition: background-color 0.2s; }
    .song-row:hover { background-color: rgba(116, 185, 255, 0.05) !important; }
    .song-row:hover .song-title { color: var(--accent-color); }

    .song-icon-placeholder {
        width: 38px; height: 38px;
        background-color: #f8f9fa; border: 1px solid rgba(0,0,0,0.02);
    }
    .text-accent { color: var(--accent-color); }
    .mono { font-family: 'SFMono-Regular', Consolas, monospace; letter-spacing: -0.5px; }

    .alert-soft-warning {
        background-color: #fff9db; border: 1px solid #ffec99; color: #f08c00;
    }

    .btn-delete-song {
        background: none; border: none; color: #adb5bd;
        transition: all 0.2s ease; padding: 5px; border-radius: 8px;
        position: relative; z-index: 2;
    }
    .btn-delete-song:hover {
        color: #ff4757; background-color: rgba(255, 71, 87, 0.1); transform: scale(1.1);
    }

    .btn-vladify-save {
        background: linear-gradient(135deg, #41d3b7 0%, #27b89d 100%);
        border: none; display: flex; align-items: center; justify-content: center;
        transition: 0.2s;
    }
    .btn-vladify-save:hover { filter: brightness(1.1); transform: scale(1.05); }

    .btn-soft-confirm {
        background-color: #ee5253; color: #fff; border: none;
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        box-shadow: 0 4px 12px rgba(238, 82, 83, 0.3);
    }
    .btn-soft-confirm:hover {
        background-color: #d43d3d; color: #fff;
        box-shadow: 0 6px 18px rgba(255, 87, 88, 0.45); transform: translateY(-1px);
    }
    .btn-soft-confirm:active { transform: scale(0.98); }

    .btn-vladify-add {
        background: linear-gradient(135deg, #41d3b7 0%, #27b89d 100%);
        border: none; color: white; font-weight: 600; transition: all 0.3s ease;
    }
    .btn-vladify-add:hover {
        background: linear-gradient(135deg, #51e3c7 0%, #2cccae 100%);
        transform: translateY(-2px);
        box-shadow: 0 6px 20px rgba(39, 184, 157, 0.4) !important; color: white;
    }
    .btn-vladify-add:active { transform: translateY(0); }

    /* ======= Upload Drop Zone ======= */
    .upload-drop-zone {
        position: relative;
        border: 2px dashed #d1d5db;
        border-radius: 16px;
        padding: 24px 16px;
        text-align: center;
        transition: all 0.3s ease;
        background: #fafbfc;
        cursor: pointer;
    }
    .upload-drop-zone:hover {
        border-color: #27b89d;
        background: rgba(39, 184, 157, 0.03);
    }
    .upload-drop-zone.drag-over {
        border-color: #27b89d;
        background: rgba(39, 184, 157, 0.08);
        transform: scale(1.01);
        box-shadow: 0 0 0 4px rgba(39, 184, 157, 0.1);
    }
    .upload-drop-zone.has-file {
        border-style: solid;
        border-color: #27b89d;
        background: rgba(39, 184, 157, 0.04);
        padding: 12px 16px;
    }
    .upload-file-input {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        opacity: 0;
        cursor: pointer;
        z-index: 1;
    }
    .upload-drop-zone.has-file .upload-file-input {
        pointer-events: none;
    }

    .upload-icon-circle {
        width: 52px; height: 52px; border-radius: 50%;
        background: linear-gradient(135deg, #e8f5e9 0%, #c8e6c9 100%);
        display: inline-flex; align-items: center; justify-content: center;
        font-size: 1.4rem; color: #27b89d;
    }
    .upload-icon-circle.audio {
        background: linear-gradient(135deg, #e3f2fd 0%, #bbdefb 100%);
        color: #42a5f5;
    }

    .upload-placeholder {
        padding: 8px 0;
    }

    .upload-preview {
        display: flex;
        align-items: center;
        gap: 14px;
        position: relative;
        z-index: 2;
    }
    .upload-preview-img {
        width: 56px; height: 56px;
        border-radius: 12px;
        object-fit: cover;
        border: 2px solid rgba(39, 184, 157, 0.2);
        box-shadow: 0 2px 8px rgba(0,0,0,0.08);
    }
    .upload-audio-icon-mini {
        width: 56px; height: 56px;
        border-radius: 12px;
        background: linear-gradient(135deg, #e3f2fd 0%, #bbdefb 100%);
        display: flex; align-items: center; justify-content: center;
        font-size: 1.5rem; color: #42a5f5; flex-shrink: 0;
        border: 2px solid rgba(66, 165, 245, 0.2);
    }
    .upload-file-info {
        flex: 1;
        min-width: 0;
        text-align: left;
    }
    .btn-upload-remove {
        background: rgba(255, 71, 87, 0.08);
        border: none;
        color: #ff4757;
        width: 32px; height: 32px;
        border-radius: 50%;
        display: flex; align-items: center; justify-content: center;
        transition: all 0.2s ease;
        flex-shrink: 0;
        cursor: pointer;
        z-index: 3;
    }
    .btn-upload-remove:hover {
        background: rgba(255, 71, 87, 0.18);
        transform: scale(1.1);
    }
    .song-cover-img {
    width: 38px;
    height: 38px;
    object-fit: cover;
    border: 1px solid rgba(0, 0, 0, 0.05);
    flex-shrink: 0;
}
</style>